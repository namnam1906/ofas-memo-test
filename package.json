{
  "name": "ekkasarn-ai",
  "version": "0.1.0",
  "private": true,
  "description": "ผู้ช่วยร่างเอกสารราชการ — Cloudflare Worker + D1 prototype backend",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
