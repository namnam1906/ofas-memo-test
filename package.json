    "db:migrate:remote": "wrangler d1 migrations apply ekkasarn_ai --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.127.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "hono": "^4.13.5"
  }
}
